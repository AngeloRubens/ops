# The official Eclipse Temurin JRE image, from the repository that publishes it. It builds, and its
# entrypoint is a script of its own, so without --resolve-entrypoint the command declines and says
# what to do instead. temurin-resolved is the same repository asked what the script starts.
DOCKERFILE=upstream/21/jre/ubuntu/noble/Dockerfile
EXPECT=refuse
ERROR_MATCH="the image runs a script"
