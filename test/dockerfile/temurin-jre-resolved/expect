# The official Eclipse Temurin 25 JRE image running a program. The image has none of its own - its
# command is jshell, which a jre does not carry - so a jar is run on it, and the package has to
# carry the jvm and the libraries it loads.
EXPECT=ok
PORT=8080
OUTPUT_MATCH="hello from java"
BUILD_FLAGS="--resolve-entrypoint"
MANIFEST_CHECK='(.Program | test("/bin/java$")) and (.Args | index("/app.jar") != null)'
