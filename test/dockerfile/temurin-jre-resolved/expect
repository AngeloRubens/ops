# The official Eclipse Temurin 25 JRE image running a program. The image has none of its own - its
# command is jshell, which a jre does not carry - so a jar is run on it, and the package has to
# carry the jvm and the libraries it loads.
EXPECT=ok
PORT=8080
OUTPUT_MATCH="hello from java"
BUILD_FLAGS="--resolve-entrypoint --verbose"
MANIFEST_CHECK='(.Program | test("/bin/java$")) and (.Args | index("/app.jar") != null)'
# watched under strace, so nothing a jvm that serves a page never opens is in the package: no
# fonts, no systemd, no apt. It does open passwd, nsswitch.conf and localtime, which stay.
SYSROOT_PRESENT="app.jar etc/passwd usr/lib/x86_64-linux-gnu/libc.so.6"
SYSROOT_ABSENT="etc/systemd usr/share/fonts etc/fonts usr/lib/x86_64-linux-gnu/libapt-pkg.so.7.0 usr/lib/x86_64-linux-gnu/libfreetype.so.6"
SYSROOT_MAX_MB=215
