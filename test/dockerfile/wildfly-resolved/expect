# Asked what it starts: standalone.sh ends in an exec of the jvm, so what comes back is the java
# command line the script works out - which is a thing a manifest can hold. Booting it is left to
# wildfly-interpreted, since a jvm compiling at full tilt under emulation is not steady enough to
# assert on.
DOCKERFILE=../wildfly/Dockerfile
EXPECT=package
BUILD_FLAGS="--resolve-entrypoint --resolve-timeout 120"
MANIFEST_CHECK='(.Program | test("java$")) and (.Args | index("org.jboss.as.standalone") != null)'
