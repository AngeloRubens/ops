# There is no database beside it and php here has no driver for one either, so what wordpress
# answers with is its own page saying so - which is wordpress running and serving.
EXPECT=ok
PORT=8080
OUTPUT_MATCH="MySQL extension"
# the php image wraps whatever it is given in an entrypoint script of its own, so what it starts is
# asked of it rather than read
BUILD_FLAGS="--resolve-entrypoint"
BOOT_WAIT=300
MANIFEST_CHECK='(.Program | test("php$")) and (.Args | index("-S") != null)'
