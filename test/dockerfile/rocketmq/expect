# The official Apache RocketMQ image, unchanged, from apache/rocketmq-docker, built the way its
# own build-image.sh builds it. Its entrypoint is a script named relative to the working
# directory, which is a shape of its own.
DOCKERFILE=upstream/image-build/Dockerfile-ubuntu
EXPECT=refuse
ERROR_MATCH="runs a script"
BUILD_FLAGS="--build-arg version=5.3.2"
