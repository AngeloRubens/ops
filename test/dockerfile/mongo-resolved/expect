# The official mongo image, asked what its entrypoint starts. mongod speaks its own protocol on its
# port and makes nothing of a plain http request - it says the length it read is not a length - so
# what says it is up is what it writes.
DOCKERFILE=../mongo/Dockerfile
EXPECT=ok
OUTPUT_MATCH="Waiting for connections"
BUILD_FLAGS="--resolve-entrypoint --resolve-timeout 240"
BOOT_WAIT=600
